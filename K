-- Leaderboard refresh
task.spawn(function()
    local TARGET = string.lower(player.Name)

    local function getRank(lbPath)
        local ok, lb = pcall(function()
            return workspace:WaitForChild("Leaderboards", 5):WaitForChild(lbPath, 5)
        end)
        if not ok or not lb then return "#??", "Error" end
        for _, desc in ipairs(lb:GetDescendants()) do
            if desc.Name == "Username" and (desc:IsA("TextLabel") or desc:IsA("TextButton")) then
                local cleanText = string.lower(desc.Text:gsub("[%s@]", ""))
                if cleanText == TARGET then
                    local rankEntry = desc.Parent
                    local rankFrame = rankEntry:FindFirstChild("Rank")
                    local rankNumObj = rankFrame and rankFrame:FindFirstChild("Label")
                    local amountObj = rankEntry:FindFirstChild("Number")
                    local amount = amountObj and amountObj.Text or ""
                    local num = rankNumObj and rankNumObj.Text or nil
                    if num then return "#" .. num, amount end
                end
            end
        end
        return "#??", "Not ranked"
    end

    local function refreshAll()
        for _, entry in ipairs(rankLabels) do
            task.spawn(function()
                entry.sVal.Text = "Searching..."
                entry.rankNum.Text = "#--"
                local rank, amount = getRank(entry.path)
                entry.rankNum.Text = rank
                entry.sVal.Text = rank ~= "#??" and amount or "Not ranked"
            end)
        end
    end

    refreshAll()
    while true do
        task.wait(30)
        refreshAll()
    end
end)
