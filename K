-- Auto Click
makeToggleRow("Auto Click", "400 CPS bottom-right", 6,
    function()
        clickEnabled = true
        local Camera = workspace.CurrentCamera
        local clicksPerSecond = 400
        clickConnection = RunService.RenderStepped:Connect(function(deltaTime)
            if clickEnabled then
                local viewportSize = Camera.ViewportSize
                local x = viewportSize.X - 10
                local y = viewportSize.Y - 10
                local clicksThisFrame = math.floor(clicksPerSecond * deltaTime)
                for i = 1, clicksThisFrame do
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
                end
            end
        end)
    end,
    function()
        clickEnabled = false
        if clickConnection then
            clickConnection:Disconnect()
            clickConnection = nil
        end
    end
)

