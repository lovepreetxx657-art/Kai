makeToggleRow("Auto Gem", "Teleports to gem spawners", 2,
    function()
        gemEnabled = true
        while gemEnabled do
            local root = getRoot()
            local success, folder = pcall(function()
                return workspace:WaitForChild("GemSpawners", 5):WaitForChild("Spawn", 5)
            end)
            if success and folder then
                for _, obj in pairs(folder:GetDescendants()) do
                    if not gemEnabled then break end
                    if obj:IsA("BasePart") and string.lower(obj.Name) == "gem" then
                        root.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.01)
                    end
                end
            end
            task.wait(0.1)
        end
    end,
    function() gemEnabled = false end
)

makeToggleRow("Auto Hatch", "Presses T at Space Egg", 3,
    function()
        hatchEnabled = true
        local root = getRoot()
        local egg = workspace:WaitForChild("Eggs"):WaitForChild("Lava Egg")
        root.CFrame = egg:IsA("Model") and egg:GetPivot() or CFrame.new(egg.Position)
        task.wait(1)
        while hatchEnabled do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
            task.wait(0.2)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
            task.wait(3)
        end
    end,
    function() hatchEnabled = false end
)

makeToggleRow("Auto Claim Rewards", "Claims gifts automatically", 4,
    function()
        claimEnabled = true
        task.spawn(function()
            playerGui.DescendantAdded:Connect(function(obj)
                if not claimEnabled then return end
                if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                    local text = (obj.Text or ""):lower()
                    local name = obj.Name:lower()
                    if text == "claim" or name == "claimbutton" or name == "claim" then
                        task.wait(0.15)
                        pcall(function() obj.MouseButton1Click:Fire() end)
                    end
                end
            end)
        end)
        task.spawn(function()
            pcall(function()
                local sf = playerGui:WaitForChild("MainUI"):WaitForChild("Menus"):WaitForChild("GiftsFrame"):WaitForChild("InnerFrame"):WaitForChild("ScrollingFrame")
                sf.DescendantAdded:Connect(function(obj)
                    if not claimEnabled then return end
                    if obj.Name == "ClaimButton" then
                        task.wait(0.1)
                        pcall(function() obj.MouseButton1Click:Fire() end)
                    end
                end)
            end)
        end)
        local Network = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Network"))
        local GiftsData = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Data"):WaitForChild("GiftsData"))
        task.wait(3)
        local claiming = {}
        while claimEnabled do
            task.wait(1)
            local data
            local ok = pcall(function() data = Network:InvokeServer("GetGiftData") end)
            if ok and data then
                local startTime = tonumber(data.t0) or os.time()
                for index, gift in ipairs(GiftsData) do
                    if not claimEnabled then break end
                    if gift.Type ~= "Pet" and not claiming[index] then
                        local claimed = data.GiftsClaimed and (
                            data.GiftsClaimed[index] == true or
                            data.GiftsClaimed[tostring(index)] == true
                        )
                        if not claimed then
                            local remaining = gift.Time - (os.time() - startTime)
                            if remaining <= 0 then
                                claiming[index] = true
                                pcall(function() tryClaim(Network, index, gift.Type) end)
                                task.wait(0.2)
                                claiming[index] = nil
                            end
                        end
                    end
                end
            end
        end
    end,
    function() claimEnabled = false end
)

