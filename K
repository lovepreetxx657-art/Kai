                    hrp.CFrame = workspace.Touches.ShopZones.Lava.CFrame + Vector3.new(0, 5, 0)
                end)
            end
            task.wait(1.5)
            -- Get data
            local ok, data = pcall(function()
                return ReplicatedStorage.Remotes.GetData:InvokeServer()
            end)
            if ok and data then
                local coins = data.Coins or 0
                local ownedFlavors = data.Flavors or {}
                -- Sort cheapest first
                local sorted = {}
                for name, info in pairs(ItemData.Flavor) do
                    table.insert(sorted, {name = name, price = info.Price or 0})
                end
                table.sort(sorted, function(a, b) return a.price < b.price end)
                -- Buy all affordable unowned
                for _, flavor in ipairs(sorted) do
                    if not fizzEnabled then break end
                    local owned = false
                    if ownedFlavors[flavor.name] == true then
                        owned = true
                    else
                        for _, v in ipairs(ownedFlavors) do
                            if v == flavor.name then owned = true break end
                        end
                    end
                    if not owned and flavor.price <= coins then
                        local buyOk, result = pcall(function()
                            return Network:InvokeServer("BuyShop", "Flavors", flavor.name)
                        end)
                        if buyOk and result then
                            coins = coins - flavor.price
                            print("[SRT] Bought fizz:", flavor.name)
                        end
                        task.wait(0.3)
                    end
                end
            end
            task.wait(5)
        end
    end,
    function() fizzEnabled = false end
)

