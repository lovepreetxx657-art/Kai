local function autoClickClaimButtons()
    pcall(function()
        local scrollingFrame = playerGui.MainUI.Menus.GiftsFrame.InnerFrame.ScrollingFrame
        for _, child in ipairs(scrollingFrame:GetChildren()) do
            local claimBtn = child:FindFirstChild("GiftInnerTemp") and child.GiftInnerTemp:FindFirstChild("ClaimButton")
            if claimBtn then claimBtn.MouseButton1Click:Fire() end
        end
    end)
end

local function tryClaim(Network, index, giftType)
    pcall(function() Network:InvokeServer("ClaimGift", index) end)
    if giftType == "Boost" then
        pcall(function() Network:InvokeServer("ClaimBoost", index) end)
        pcall(function() Network:InvokeServer("ClaimReward", index) end)
        pcall(function() Network:InvokeServer("Claim", index) end)
    end
    task.wait(0.3)
    autoClickClaimButtons()
end

local clickConnection = nil

local function stopAutoClick()
    clickEnabled = false
    if clickConnection then
        clickConnection:Disconnect()
        clickConnection = nil
    end
    local vp = workspace.CurrentCamera.ViewportSize
    for i = 1, 5 do
        VirtualInputManager:SendMouseButtonEvent(vp.X - 1, vp.Y - 1, 0, false, game, 0)
    end
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.A, false, game)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.S, false, game)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.D, false, game)
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    end
end

local function startAutoClick()
    if clickConnection then clickConnection:Disconnect() clickConnection = nil end
    clickEnabled = true
    local Camera = workspace.CurrentCamera
    clickConnection = RunService.Heartbeat:Connect(function()
        if not clickEnabled then return end
        local vp = Camera.ViewportSize
        VirtualInputManager:SendMouseButtonEvent(vp.X - 1, vp.Y - 1, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(vp.X - 1, vp.Y - 1, 0, false, game, 0)
    end)
end

