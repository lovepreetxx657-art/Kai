        for _, desc in ipairs(lb:GetDescendants()) do
            if desc.Name == "Username" and (desc:IsA("TextLabel") or desc:IsA("TextButton")) then
                -- Clean the text: remove spaces, @, and lowercase
                local cleanText = string.lower(desc.Text:gsub("[%s@]", ""))
                if cleanText == TARGET then
                    -- Found player! Go up to the rank entry (desc.Parent = Rank_N)
                    local rankEntry = desc.Parent
                    -- Get rank number from Rank > Label
                    local rankFrame = rankEntry:FindFirstChild("Rank")
                    local rankNum = rankFrame and rankFrame:FindFirstChild("Label")
                    -- Get amount
                    local amountObj = rankEntry:FindFirstChild("Number")
                    local amount = amountObj and amountObj.Text or ""
                    local num = rankNum and rankNum.Text or nil
                    if num then
                        return "#" .. num, amount
                    end
                end
            end
        end
        return "#??", "Not ranked"
    end

    local function refreshAll()
        for _, entry in ipairs(rankLabels) do
            task.spawn(function()
                entry.sVal.Text = "Searching..."
                entry.rankNum.Text = "#--"
                local rank, amount = getRank(entry.path)
                entry.rankNum.Text = rank
                entry.sVal.Text = rank ~= "#??" and amount or "Not ranked"
            end)
        end
    end

    refreshAll()
    while true do
        task.wait(30)
        refreshAll()
    end
end)
