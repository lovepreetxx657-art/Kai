makeToggleRow("AFK Bypass", "Prevents idle kick", 8,
    function()
        afkEnabled = true
        afkGui, afkStatusLabel = createAFKGui()
        player.Idled:Connect(function()
            if not afkEnabled then return end
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
            if afkStatusLabel and afkStatusLabel.Parent then
                afkStatusLabel.Text = "Roblox tried to kick you but we didn't let them :D"
                task.wait(2)
                if afkEnabled then
                    afkStatusLabel.Text = "Status: Active"
                end
            end
        end)
    end,
    function()
        afkEnabled = false
        if afkGui and afkGui.Parent then
            afkGui:Destroy()
            afkGui = nil
            afkStatusLabel = nil
        end
    end
)

