-- 🌸 BUTTON CREATOR
local function createButton(text, yPos)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 300, 0, 40)
    Btn.Position = UDim2.new(0.5, -150, 0, yPos)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 25, 35)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(255, 10, 130)
    Btn.TextSize = 18
    Btn.Font = Enum.Font.GothamBold
    Btn.Parent = Frame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = Btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 10, 130)
    stroke.Thickness = 1
    stroke.Parent = Btn

    return Btn
end

-- 🌸 BUTTONS
local InfWinsBtn = createButton("Inf Wins", 200)
local AutoSpeedBtn = createButton("Auto Speed", 260)
