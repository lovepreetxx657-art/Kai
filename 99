-- 🌸 INF WINS (firetouchinterest + stops correctly)
local infWins = false
InfWinsBtn.MouseButton1Click:Connect(function()
    infWins = not infWins
    InfWinsBtn.Text = infWins and "Inf Wins: ON" or "Inf Wins"

    if infWins then
        task.spawn(function()
            local target = workspace:WaitForChild("GiveWins"):WaitForChild("Button13"):WaitForChild("Touch")
            while infWins do
                local char = player.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        firetouchinterest(root, target, 0)
                        firetouchinterest(root, target, 1)
                    end
                end
                task.wait(0.5) -- 2x per second
            end
        end)
    end
end)

-- 🌸 AUTO SPEED (smooth, non‑laggy, still very fast)
local autoSpeed = false
AutoSpeedBtn.MouseButton1Click:Connect(function()
    autoSpeed = not autoSpeed
    AutoSpeedBtn.Text = autoSpeed and "Auto Speed: ON" or "Auto Speed"

    if autoSpeed then
        task.spawn(function()
            while autoSpeed do
                -- 5 fires every 0.005 sec = 100/sec
                for i = 1, 5 do
                    ReplicatedStorage.Events.AddSpeed:FireServer()
                end
                task.wait(0.005)
            end
        end)
    end
end)

-- 🌸 AUTO REBIRTH (0.25 sec + stops correctly)
local autoRebirth = false
AutoRebirthBtn.MouseButton1Click:Connect(function()
