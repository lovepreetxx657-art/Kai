-- HELPERS
local function makeLabel(text, y, size, color)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1,-20,0,18)
	l.Position = UDim2.new(0,10,0,y)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color or Color3.fromRGB(160,160,160)
	l.Font = Enum.Font.Gotham
	l.TextSize = size or 11
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = panel
	return l
end

local function makeBtn(text, y, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-20,0,32)
	b.Position = UDim2.new(0,10,0,y)
	b.BackgroundColor3 = color or Color3.fromRGB(40,40,65)
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = Color3.fromRGB(230,230,230)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.Parent = panel
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,7)
	return b
end

-- TITLE
makeLabel("AUTO FARM", 10, 13, Color3.fromRGB(220,220,220))
local clickCountLabel = makeLabel("Clicks: 0", 28, 10)

-- BUTTONS
local y = 46
local function nextBtn(text, color)
	local b = makeBtn(text, y, color)
	y += 34
	return b
end

local clickBtn    = nextBtn("Auto Click: OFF",        Color3.fromRGB(50,50,80))
local rebirthBtn  = nextBtn("Auto Rebirth: OFF",      Color3.fromRGB(50,50,80))
local masteryBtn  = nextBtn("Auto Mastery: OFF",      Color3.fromRGB(50,50,80))
local hatchBtn    = nextBtn("Auto Hatch: OFF",         Color3.fromRGB(50,50,80))
local potionBtn   = nextBtn("Auto Buy Potions: OFF",  Color3.fromRGB(50,50,80))
local upgradesBtn = nextBtn("Auto Buy Upgrades: OFF", Color3.fromRGB(50,50,80))

local statusLabel = makeLabel("Status: idle", y + 4, 10, Color3.fromRGB(239,159,39))

-- TOGGLE PANEL
local panelOpen = true
tab.MouseButton1Click:Connect(function()
	panelOpen = not panelOpen
	panel.Visible = panelOpen
	tab.Text = panelOpen and "<" or ">"
end)

-- AUTO CLICK
clickBtn.MouseButton1Click:Connect(function()
	autoClickEnabled = not autoClickEnabled
	if autoClickEnabled then
		clickBtn.Text = "Auto Click: ON"
		clickBtn.BackgroundColor3 = Color3.fromRGB(50,168,82)
	else
		clickBtn.Text = "Auto Click: OFF"
		clickBtn.BackgroundColor3 = Color3.fromRGB(50,50,80)
	end
end)

-- AUTO REBIRTH
rebirthBtn.MouseButton1Click:Connect(function()
	autoRebirthEnabled = not autoRebirthEnabled
	if autoRebirthEnabled then
		rebirthBtn.Text = "Auto Rebirth: ON"
		rebirthBtn.BackgroundColor3 = Color3.fromRGB(239,159,39)
		statusLabel.Text = "Status: auto rebirth"
		task.spawn(function()
			while autoRebirthEnabled do
				rebirthEvent:FireServer(50000000000000) -- 50T
				task.wait(0.05)
			end
		end)
	else
		rebirthBtn.Text = "Auto Rebirth: OFF"
		rebirthBtn.BackgroundColor3 = Color3.fromRGB(50,50,80)
		statusLabel.Text = "Status: idle"
	end
end)

