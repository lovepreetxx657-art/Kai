-- AUTO BUY POTIONS
potionBtn.MouseButton1Click:Connect(function()
	autoPotionEnabled = not autoPotionEnabled
	if autoPotionEnabled then
		potionBtn.Text = "Auto Buy Potions: ON"
		potionBtn.BackgroundColor3 = Color3.fromRGB(50,168,82)
		statusLabel.Text = "Status: auto potions"
		task.spawn(function()
			while autoPotionEnabled do
				buyPotionFunction:InvokeServer("Click", 100)
				task.wait(0.1)
				buyPotionFunction:InvokeServer("Gem", 100)
				task.wait(0.1)
				buyPotionFunction:InvokeServer("Rebirth", 100)
				task.wait(0.1)
				buyPotionFunction:InvokeServer("Luck", 100)
				local timer = 0
				while timer < 1200 and autoPotionEnabled do
					task.wait(1)
					timer += 1
				end
			end
			potionBtn.Text = "Auto Buy Potions: OFF"
			potionBtn.BackgroundColor3 = Color3.fromRGB(50,50,80)
			statusLabel.Text = "Status: idle"
		end)
	else
		autoPotionEnabled = false
	end
end)

