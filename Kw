-- POTION HELPER
local function startPotion(getEnabled, btn, label, potionType)
	task.spawn(function()
		while getEnabled() do
			buyPotionFunction:InvokeServer(potionType, 100)
			local timer = 0
			while timer < 1200 and getEnabled() do
				task.wait(1)
				timer += 1
			end
		end
		btn.Text = "Auto "..label.." Potion: OFF"
		btn.BackgroundColor3 = Color3.fromRGB(50,50,80)
		statusLabel.Text = "Status: idle"
	end)
end

