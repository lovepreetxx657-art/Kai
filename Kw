-- MAIN LOOP
RunService.Heartbeat:Connect(function(dt)
	if autoClickEnabled then
		clickTimer += dt
		if clickTimer >= 0.1 then
			clickTimer = 0
			clickCount += 1
			clickCountLabel.Text = "Clicks: "..clickCount
			clickEvent:FireServer()
		end
	end
end)
